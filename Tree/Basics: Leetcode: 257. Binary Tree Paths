Approach 2 — BFS + Store Path in Queue

We can also solve the problem using BFS.

Instead of storing only the node in the queue, store:

(node, path-to-that-node)

For every node:

newPath = currentPath + currentNode

When we reach a leaf, add the path to the answer.

Code
import java.util.*;

class Pair {
    TreeNode node;
    String path;

    Pair(TreeNode node, String path) {
        this.node = node;
        this.path = path;
    }
}

class Solution {

    public List<String> binaryTreePaths(TreeNode root) {

        List<String> result = new ArrayList<>();

        if (root == null) {
            return result;
        }

        Queue<Pair> q = new LinkedList<>();

        q.offer(new Pair(root, String.valueOf(root.val)));

        while (!q.isEmpty()) {

            Pair curr = q.poll();

            TreeNode node = curr.node;
            String path = curr.path;

            // Leaf
            if (node.left == null && node.right == null) {
                result.add(path);
                continue;
            }

            if (node.left != null) {
                q.offer(
                    new Pair(
                        node.left,
                        path + "->" + node.left.val
                    )
                );
            }

            if (node.right != null) {
                q.offer(
                    new Pair(
                        node.right,
                        path + "->" + node.right.val
                    )
                );
            }
        }

        return result;
    }
}

