                if (curr.right != null) {
                    sum += curr.right.data;
                }

                if (curr.data != sum) {
                    return false;
                }

                if (curr.left != null) {
                    q.add(curr.left);
                }

                if (curr.right != null) {
                    q.add(curr.right);
                }
            }
        }

        return true;
    }
}

