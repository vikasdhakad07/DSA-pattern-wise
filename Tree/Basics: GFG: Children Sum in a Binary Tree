import java.util.*;

class Solution {

    public boolean isSumProperty(Node root) {

        if (root == null) {
            return true;
        }

        Queue<Node> q = new LinkedList<>();
        q.offer(root);

        while (!q.isEmpty()) {

            Node curr = q.poll();

            if (curr.left == null && curr.right == null) {
                continue;
            }

            int sum = 0;

            if (curr.left != null) {
                sum += curr.left.data;
            }

            if (curr.right != null) {
                sum += curr.right.data;
            }

            if (curr.data != sum) {
                return false;
            }

            if (curr.left != null) {
                q.offer(curr.left);
            }

            if (curr.right != null) {
                q.offer(curr.right);
            }
        }

        return true;
    }
}

This has exactly the same asymptotic complexity as your version but less code.

