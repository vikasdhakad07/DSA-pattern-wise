Step 1 — Find Path

We use DFS + backtracking.

boolean findPath(TreeNode root, TreeNode target,
                 List<TreeNode> path)

The path contains nodes from root to target.

Code
class Solution {

    boolean findPath(
            TreeNode root,
            TreeNode target,
            List<TreeNode> path) {

        if (root == null) {
            return false;
        }

        path.add(root);

        if (root == target) {
            return true;
        }

        if (findPath(root.left, target, path)
                || findPath(root.right, target, path)) {
            return true;
        }

        // Backtrack
        path.remove(path.size() - 1);

        return false;
    }

    public TreeNode lowestCommonAncestor(
            TreeNode root,
            TreeNode p,
            TreeNode q) {

        List<TreeNode> pathP = new ArrayList<>();
        List<TreeNode> pathQ = new ArrayList<>();

        findPath(root, p, pathP);
        findPath(root, q, pathQ);

        TreeNode answer = null;

        int i = 0;

        while (i < pathP.size()
                && i < pathQ.size()
                && pathP.get(i) == pathQ.get(i)) {

            answer = pathP.get(i);
            i++;
        }

        return answer;
    }
}

