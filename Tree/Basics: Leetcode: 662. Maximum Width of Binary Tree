Approach 2 — DFS + Index in One Traversal

We don't need to traverse the entire tree separately for every level.

We can traverse the tree once.

At each depth, maintain:

first index seen at this depth

For the current node:

width = currentIndex - firstIndexAtDepth + 1

Then recursively process children.

Code
import java.util.*;

class Solution {

    List<Long> firstIndex = new ArrayList<>();

    int answer = 0;

    void dfs(
            TreeNode root,
            int depth,
            long index) {

        if (root == null) {
            return;
        }

        // First node encountered at this level
        if (depth == firstIndex.size()) {
            firstIndex.add(index);
        }

        long width =
                index - firstIndex.get(depth) + 1;

        answer = Math.max(
                answer,
                (int) width
        );

        dfs(
                root.left,
                depth + 1,
                2 * index
        );

        dfs(
                root.right,
                depth + 1,
                2 * index + 1
        );
    }

    public int widthOfBinaryTree(TreeNode root) {

        if (root == null) {
            return 0;
        }

        firstIndex.clear();
        answer = 0;

        dfs(root, 0, 0);

        return answer;
    }
}

