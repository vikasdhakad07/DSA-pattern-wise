Approach 4 — Optimal Robust BFS with Normalized Indices ⭐

This is the version I recommend.

Key Idea

At the beginning of every level, let:

firstIndex = index of leftmost node

Then instead of using the huge absolute index, normalize every index:

normalizedIndex = currentIndex - firstIndex

So the first node always becomes:

0

and the others become relative positions.

Then children are generated using these normalized indices:

left  = 2 * normalizedIndex
right = 2 * normalizedIndex + 1

This keeps the numbers small.

Code
class Pair {
    TreeNode node;
    long idx;

    Pair(TreeNode node, long idx) {
        this.node = node;
        this.idx = idx;
    }
}

class Solution {

    public int widthOfBinaryTree(TreeNode root) {

        if (root == null) {
            return 0;
        }

        Queue<Pair> q = new LinkedList<>();

        q.offer(new Pair(root, 0));

        long maxWidth = 0;

        while (!q.isEmpty()) {

            int size = q.size();

            // Leftmost index of current level
            long firstIndex = q.peek().idx;

            long first = 0;
            long last = 0;

            for (int i = 0; i < size; i++) {

                Pair curr = q.poll();

                // Normalize index
                long idx = curr.idx - firstIndex;

                if (i == 0) {
                    first = idx;
                }

                if (i == size - 1) {
                    last = idx;
                }

                if (curr.node.left != null) {
                    q.offer(
                        new Pair(
                            curr.node.left,
                            2 * idx
                        )
                    );
                }

                if (curr.node.right != null) {
                    q.offer(
                        new Pair(
                            curr.node.right,
                            2 * idx + 1
                        )
                    );
                }
            }

            long width = last - first + 1;

            maxWidth = Math.max(
                    maxWidth,
                    width
            );
        }

        return (int) maxWidth;
    }
}

