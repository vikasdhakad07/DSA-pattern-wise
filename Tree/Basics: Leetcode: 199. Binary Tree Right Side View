class Solution {
    public List<Integer> rightSideView(TreeNode root) {

        List<Integer> al = new ArrayList<>();

        if (root == null) {
            return al;
        }

        Queue<TreeNode> q = new LinkedList<>();
        q.add(root);

        while (!q.isEmpty()) {

            int size = q.size();

            for (int i = 0; i < size; i++) {

                TreeNode curr = q.poll();

                // Last node of this level
                if (i == size - 1) {
                    al.add(curr.val);
                }

                if (curr.left != null) {
                    q.add(curr.left);
                }

                if (curr.right != null) {
                    q.add(curr.right);
                }
            }
        }

        return al;
    }
}

This is the version I'd recommend remembering.

