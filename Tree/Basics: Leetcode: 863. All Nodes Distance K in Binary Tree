Approach 2 — DFS + Ancestor Backtracking

This approach avoids building a parent map entirely.

Idea

Use recursion to find the target.

When the target is found:

Collect nodes k edges below it.

Return the distance from the target to its ancestors.

At each ancestor, either include that ancestor or search its opposite subtree.

For example:

                 3
               /   \
              5     1
             / \   / \
            6   2 0   8
               / \
              7   4

When target 5 is found, collect nodes at distance 2 below it:

         5
        / \
       6   2
          / \
         7   4

This produces:

[7, 4]

Then return up to ancestor 3.

The target is one edge away from 3, so we need the remaining distance:

k = 2
distance to ancestor = 1
remaining distance into opposite subtree = 2 - 1 - 1 = 0

The opposite subtree's root is 1, so add it.

Final:

[7, 4, 1]
Code
import java.util.*;

class Solution {

    public List<Integer> distanceK(
            TreeNode root,
            TreeNode target,
            int k) {

        List<Integer> answer = new ArrayList<>();

        if (root == null || target == null) {
            return answer;
        }

        findTarget(root, target, k, answer);

        return answer;
    }

    // Returns the distance from this node to target,
    // or -1 when the target is not in this subtree.
    private int findTarget(
            TreeNode root,
            TreeNode target,
            int k,
            List<Integer> answer) {

        if (root == null) {
            return -1;
        }

        if (root == target) {
            collectDown(root, k, answer);
            return 0;
        }

        int leftDistance =
                findTarget(root.left, target, k, answer);

        if (leftDistance != -1) {

            int distanceToCurrent = leftDistance + 1;

            if (distanceToCurrent == k) {
                answer.add(root.val);
            } else {
                collectDown(
                    root.right,
                    k - leftDistance - 2,
                    answer
                );
            }

            return distanceToCurrent;
        }

        int rightDistance =
                findTarget(root.right, target, k, answer);

        if (rightDistance != -1) {

            int distanceToCurrent = rightDistance + 1;

            if (distanceToCurrent == k) {
                answer.add(root.val);
            } else {
                collectDown(
                    root.left,
                    k - rightDistance - 2,
                    answer
                );
            }

            return distanceToCurrent;
        }

        return -1;
    }

    // Collect descendants exactly distance edges away.
    private void collectDown(
            TreeNode root,
            int distance,
            List<Integer> answer) {

        if (root == null || distance < 0) {
            return;
        }

        if (distance == 0) {
            answer.add(root.val);
            return;
        }

        collectDown(root.left, distance - 1, answer);
        collectDown(root.right, distance - 1, answer);
    }
}
