Approach 1 — Brute Force Using ArrayList
Idea

Convert the linked list into an ArrayList.

Then process the values in groups of k:

1 2 3 | 4 5 6 | 7

Reverse each complete group in the array.

Finally create a new linked list.

Code
class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {

        ArrayList<Integer> arr = new ArrayList<>();

        ListNode curr = head;

        // Store values
        while (curr != null) {
            arr.add(curr.val);
            curr = curr.next;
        }

        // Reverse every complete group
        for (int i = 0; i + k <= arr.size(); i += k) {
            int left = i;
            int right = i + k - 1;

            while (left < right) {
                int temp = arr.get(left);
                arr.set(left, arr.get(right));
                arr.set(right, temp);

                left++;
                right--;
            }
        }

        // Create new linked list
        ListNode dummy = new ListNode(0);
        curr = dummy;

        for (int value : arr) {
            curr.next = new ListNode(value);
            curr = curr.next;
        }

        return dummy.next;
    }
}

