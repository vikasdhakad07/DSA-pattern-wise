Java (Your Code)
class Solution {

    public int[] nextGreaterElements(int[] nums) {

        int n = nums.length;

        int ans[] = new int[n];

        Stack<Integer> st = new Stack<>();

        st.add(nums[nums.length - 1]);

        ans[n - 1] = -1;

        for (int i = 2 * n - 1; i >= 0; i--) {

            while (!st.isEmpty() && st.peek() <= nums[i % n]) {

                st.pop();
            }

            if (i < n) {

                if (!st.isEmpty()) {

                    ans[i] = st.peek();

                } else {

                    ans[i] = -1;
                }
            }

            st.push(nums[i % n]);
        }

        return ans;
    }
}

