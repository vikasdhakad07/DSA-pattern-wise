Java (Your Code)
class Solution {

    public int maximalRectangle(char[][] matrix) {

        if (matrix == null || matrix.length == 0) {
            return 0;
        }

        int m = matrix.length;
        int n = matrix[0].length;

        int max = 0;

        int ans[] = new int[n];

        for (int i = 0; i < m; i++) {

            for (int j = 0; j < n; j++) {

                ans[j] =
                    matrix[i][j] == '1'
                    ? ans[j] + 1
                    : 0;
            }

            max = Math.max(max, findMax(ans));
        }

        return max;
    }

    public int findMax(int ans[]) {

        int max = 0;

        Stack<Integer> st = new Stack<>();

        int n = ans.length;

        for (int i = 0; i <= n; i++) {

            int h = (i == n) ? 0 : ans[i];

            while (!st.isEmpty() &&
                   h < ans[st.peek()]) {

                int height = ans[st.pop()];

                int width =
                        st.isEmpty()
                        ? i
                        : i - st.peek() - 1;

                max = Math.max(max,
                        height * width);
            }

            st.push(i);
        }

        return max;
    }
}

