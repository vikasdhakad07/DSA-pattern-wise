Approach 3: BFS — Right Child First ⭐

We can make the BFS even more intuitive.

Instead of:

left → right

process:

right → left

Then the first node of every level is the rightmost visible node.

Java

class Solution {

    public List<Integer> rightSideView(TreeNode root) {

        List<Integer> ans = new ArrayList<>();

        if (root == null) {
            return ans;
        }

        Queue<TreeNode> q = new LinkedList<>();

        q.add(root);

        while (!q.isEmpty()) {

            int size = q.size();

            for (int i = 0; i < size; i++) {

                TreeNode curr = q.poll();

                // First node of every level
                if (i == 0) {
                    ans.add(curr.val);
                }

                // Right first
                if (curr.right != null) {
                    q.add(curr.right);
                }

                if (curr.left != null) {
                    q.add(curr.left);
                }
            }
        }

        return ans;
    }
}

